ocio_profile_version: 2
search_path: ""
strictparsing: true

roles:
  default: fixture_linear
  scene_linear: fixture_linear

file_rules:
  - !<Rule> {name: Default, colorspace: fixture_linear}

displays:
  FixtureDisplay:
    - !<View> {name: FixtureView, colorspace: fixture_display}
    - !<View> {name: Raw, colorspace: fixture_linear}

active_displays: [FixtureDisplay]
active_views: [FixtureView, Raw]

colorspaces:
  - !<ColorSpace>
    name: fixture_linear
    bitdepth: 32f
    isdata: false
    allocation: uniform

  - !<ColorSpace>
    name: fixture_half
    bitdepth: 32f
    isdata: false
    allocation: uniform
    to_scene_reference: !<MatrixTransform>
      matrix: [2, 0, 0, 0, 0, 2, 0, 0, 0, 0, 2, 0, 0, 0, 0, 1]

  - !<ColorSpace>
    name: fixture_display
    bitdepth: 32f
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform>
      matrix: [0.5, 0, 0, 0, 0, 0.5, 0, 0, 0, 0, 0.5, 0, 0, 0, 0, 1]
      offset: [0.1, 0.2, 0.3, 0]
